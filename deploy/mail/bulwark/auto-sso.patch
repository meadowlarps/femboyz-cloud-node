diff --git a/lib/auth/__tests__/auto-sso.test.ts b/lib/auth/__tests__/auto-sso.test.ts
new file mode 100644
index 0000000..d09903f
--- /dev/null
+++ b/lib/auth/__tests__/auto-sso.test.ts
@@ -0,0 +1,31 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { beginAutoSsoAttempt, clearAutoSsoAttempt } from '../auto-sso';
+
+beforeEach(() => { sessionStorage.clear(); vi.restoreAllMocks(); });
+
+describe('automatic SSO across document navigation', () => {
+  it('migrates the permanent legacy flag and starts immediately', () => {
+    sessionStorage.setItem('sso_attempted', '1');
+    expect(beginAutoSsoAttempt(100_000)).toBe(true);
+    expect(sessionStorage.getItem('sso_attempted')).toBeNull();
+  });
+  it('expires a failed-attempt guard even when navigation destroyed its timer', () => {
+    expect(beginAutoSsoAttempt(100_000)).toBe(true);
+    expect(beginAutoSsoAttempt(129_999)).toBe(false);
+    expect(beginAutoSsoAttempt(130_000)).toBe(true);
+  });
+  it('allows a fresh login immediately after successful authentication', () => {
+    beginAutoSsoAttempt(100_000);
+    clearAutoSsoAttempt();
+    expect(beginAutoSsoAttempt(100_001)).toBe(true);
+  });
+  it.each(['broken', 'Infinity', '-1', '9999999999999'])('does not strand users with invalid timestamp %s', value => {
+    sessionStorage.setItem('sso_attempted_at', value);
+    expect(beginAutoSsoAttempt(100_000)).toBe(true);
+  });
+  it('allows login when browser storage is blocked', () => {
+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('blocked'); });
+    expect(beginAutoSsoAttempt()).toBe(true);
+    expect(() => clearAutoSsoAttempt()).not.toThrow();
+  });
+});
diff --git a/lib/auth/auto-sso.ts b/lib/auth/auto-sso.ts
new file mode 100644
index 0000000..cad36da
--- /dev/null
+++ b/lib/auth/auto-sso.ts
@@ -0,0 +1,21 @@
+// A timestamp survives an OAuth round trip; a timer on the old document does not.
+const ATTEMPT_KEY = 'sso_attempted_at';
+const RETRY_DELAY_MS = 30_000;
+
+export function beginAutoSsoAttempt(now = Date.now()): boolean {
+  try {
+    // Migrate the old permanent flag left by pre-patch login pages.
+    sessionStorage.removeItem('sso_attempted');
+    const previous = Number(sessionStorage.getItem(ATTEMPT_KEY));
+    if (previous > 0 && now >= previous && now - previous < RETRY_DELAY_MS) return false;
+    sessionStorage.setItem(ATTEMPT_KEY, String(now));
+  } catch { /* storage unavailable: the page's ref still prevents duplicate starts */ }
+  return true;
+}
+
+export function clearAutoSsoAttempt(): void {
+  try {
+    sessionStorage.removeItem(ATTEMPT_KEY);
+    sessionStorage.removeItem('sso_attempted');
+  } catch { /* storage unavailable */ }
+}
