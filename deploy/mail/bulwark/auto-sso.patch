@@ -0,0 +1,27 @@
+"use client";
+
+import { Loader2 } from '@/components/icons';
+import { Button } from '@/components/ui/button';
+
+type Props = { appName: string; logoUrl: string; failed: boolean; onRetry: () => void };
+
+export function AutoSsoScreen({ appName, logoUrl, failed, onRetry }: Props) {
+  return (
+    <main className="min-h-screen flex items-center justify-center bg-background text-foreground px-4">
+      <div className="w-full max-w-sm text-center space-y-6">
+        {logoUrl && <img src={logoUrl} alt={appName} className="object-contain mx-auto" style={{ maxWidth: '160px', maxHeight: '160px' }} />}
+        {failed ? (
+          <div role="alert" className="space-y-4">
+            <p>We couldn’t check your login.</p>
+            <Button onClick={onRetry}>Try again</Button>
+          </div>
+        ) : (
+          <div role="status" aria-live="polite" className="space-y-4">
+            <Loader2 aria-hidden="true" className="w-7 h-7 animate-spin mx-auto" style={{ color: '#c30f45' }} />
+            <p>Checking login…</p>
+          </div>
+        )}
+      </div>
+    </main>
+  );
+}
