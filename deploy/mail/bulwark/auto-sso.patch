+import React from 'react';
+import { cleanup, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { canStartAutoSso, recordAutoSsoFailure } from '@/lib/auth/auto-sso';
+import OAuthCallbackPage from '../page';
+
+const state = vi.hoisted(() => ({
+  query: 'code=one-time-code&state=paired-state',
+  login: vi.fn(), push: vi.fn(),
+}));
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ push: state.push }),
+  useParams: () => ({ locale: 'en' }),
+  useSearchParams: () => new URLSearchParams(state.query),
+}));
+vi.mock('next-intl', () => ({ useTranslations: () => (key: string) => key }));
+vi.mock('@/stores/auth-store', () => ({
+  useAuthStore: () => ({ loginWithOAuth: state.login, loginWithServerSso: state.login }),
+}));
+vi.mock('@/lib/browser-navigation', () => ({
+  getPathPrefix: () => '', toRouterPath: (path: string) => path, apiFetch: vi.fn(),
+}));
+vi.mock('@/lib/auth/lite-oauth', () => ({ LITE_OAUTH_AVAILABLE: false, getLiteOAuthRedirectUri: () => '' }));
+
+beforeEach(() => {
+  sessionStorage.clear(); vi.clearAllMocks();
+  state.query = 'code=one-time-code&state=paired-state';
+});
+afterEach(cleanup);
+
+it('records an OAuth denial as a real failure and retains the error screen', async () => {
+  state.query = 'error=access_denied';
+  render(<OAuthCallbackPage />);
+  await screen.findByText('oauth_error.access_denied');
+  expect(canStartAutoSso()).toBe(false);
+  expect(state.login).not.toHaveBeenCalled();
+  expect(state.push).not.toHaveBeenCalled();
+});
+
+it('records an unsuccessful server-side exchange instead of starting another login', async () => {
+  state.login.mockResolvedValue(false);
+  render(<OAuthCallbackPage />);
+  await screen.findByText('oauth_error.token_exchange_failed');
+  expect(canStartAutoSso()).toBe(false);
+  expect(state.push).not.toHaveBeenCalled();
+});
+
+it('clears a previous failure only after the server-side login succeeds', async () => {
+  recordAutoSsoFailure();
+  state.login.mockResolvedValue(true);
+  render(<OAuthCallbackPage />);
+  await waitFor(() => expect(state.push).toHaveBeenCalledWith('/en'));
+  expect(canStartAutoSso()).toBe(true);
+});
