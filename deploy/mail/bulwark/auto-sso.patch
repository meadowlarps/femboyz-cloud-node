+"use client";
+
+import { useEffect, useState } from 'react';
+import { Loader2 } from '@/components/icons';
+import { Button } from '@/components/ui/button';
+
+type Props = { failed: boolean; onRetry: () => void };
+
+export function AutoSsoScreen({ failed, onRetry }: Props) {
+  const [showProgress, setShowProgress] = useState(false);
+  useEffect(() => {
+    // Fast redirects stay on the site's background. A slow check gets one
+    // stable status, without waiting for config or a logo image to load.
+    const timer = window.setTimeout(() => setShowProgress(true), 700);
+    return () => window.clearTimeout(timer);
+  }, []);
+
+  return (
+    <main className="min-h-screen flex items-center justify-center bg-background text-foreground px-4" style={{ backgroundColor: '#1b1a1a', color: '#f4f4f4' }} aria-busy={!failed}>
+      {failed ? (
+        <div role="alert" className="text-center space-y-4">
+          <p>We couldn’t check your login.</p>
+          <Button onClick={onRetry}>Try again</Button>
+        </div>
+      ) : (
+        <div role="status" aria-live="polite" className={showProgress ? 'text-center space-y-4' : 'sr-only'}>
+          {showProgress && <Loader2 aria-hidden="true" className="w-7 h-7 animate-spin mx-auto" style={{ color: '#c30f45' }} />}
+          <p>Checking login…</p>
+        </div>
+      )}
+    </main>
+  );
+}
