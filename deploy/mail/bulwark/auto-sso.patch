+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { canStartAutoSso, clearAutoSsoAttempt, recordAutoSsoFailure } from '../auto-sso';
+
+beforeEach(() => { sessionStorage.clear(); vi.restoreAllMocks(); });
+
+describe('automatic SSO across document navigation', () => {
+  it('retries immediately after leaving the provider login through the home logo', () => {
+    expect(canStartAutoSso(100_000)).toBe(true);
+    // No callback: the user abandoned login and clicked Mail again seconds later.
+    expect(canStartAutoSso(103_000)).toBe(true);
+    expect(canStartAutoSso(105_000)).toBe(true);
+  });
+  it('migrates both old pending-attempt guards even when they are recent', () => {
+    sessionStorage.setItem('sso_attempted', '1');
+    sessionStorage.setItem('sso_attempted_at', '100000');
+    expect(canStartAutoSso(100_001)).toBe(true);
+    expect(sessionStorage.getItem('sso_attempted')).toBeNull();
+    expect(sessionStorage.getItem('sso_attempted_at')).toBeNull();
+  });
+  it('pauses automatic retries only after an actual failed callback', () => {
+    recordAutoSsoFailure(100_000);
+    expect(canStartAutoSso(129_999)).toBe(false);
+    expect(canStartAutoSso(130_000)).toBe(true);
+  });
+  it('allows a fresh login immediately after successful authentication', () => {
+    recordAutoSsoFailure(100_000);
+    clearAutoSsoAttempt();
+    expect(canStartAutoSso(100_001)).toBe(true);
+  });
+  it.each(['broken', 'Infinity', '-1', '9999999999999'])('does not strand users with invalid failure timestamp %s', value => {
+    sessionStorage.setItem('auto_sso_failed_at', value);
+    expect(canStartAutoSso(100_000)).toBe(true);
+  });
+  it('allows login when browser storage is blocked', () => {
+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('blocked'); });
+    expect(canStartAutoSso()).toBe(true);
+    expect(() => clearAutoSsoAttempt()).not.toThrow();
+    expect(() => recordAutoSsoFailure()).not.toThrow();
+  });
+});
diff --git a/lib/auth/auto-sso.ts b/lib/auth/auto-sso.ts
new file mode 100644
index 0000000..0a5f998
--- /dev/null
+++ b/lib/auth/auto-sso.ts
@@ -0,0 +1,28 @@
+// An abandoned sign-in is not an authentication failure. Only callbacks that
+// actually failed pause automatic retries; explicit return visits can start again.
+const FAILURE_KEY = 'auto_sso_failed_at';
+const RETRY_DELAY_MS = 30_000;
+
+export function canStartAutoSso(now = Date.now()): boolean {
+  try {
+    // Migrate both previous pending-attempt guards, including abandoned flows.
+    sessionStorage.removeItem('sso_attempted');
+    sessionStorage.removeItem('sso_attempted_at');
+    const failure = Number(sessionStorage.getItem(FAILURE_KEY));
+    if (failure > 0 && now >= failure && now - failure < RETRY_DELAY_MS) return false;
+    sessionStorage.removeItem(FAILURE_KEY);
+  } catch { /* storage unavailable: the page's ref still prevents duplicate starts */ }
+  return true;
+}
+
+export function recordAutoSsoFailure(now = Date.now()): void {
+  try { sessionStorage.setItem(FAILURE_KEY, String(now)); } catch { /* storage unavailable */ }
+}
+
+export function clearAutoSsoAttempt(): void {
+  try {
+    sessionStorage.removeItem(FAILURE_KEY);
+    sessionStorage.removeItem('sso_attempted_at');
+    sessionStorage.removeItem('sso_attempted');
+  } catch { /* storage unavailable */ }
+}
