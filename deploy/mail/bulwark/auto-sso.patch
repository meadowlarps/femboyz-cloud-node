+import React from 'react';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import { AutoSsoScreen } from '../auto-sso-screen';
+
+afterEach(cleanup);
+it('shows an accessible checking message with no extra sign-in button', () => {
+  render(<AutoSsoScreen appName="femboyz mail" logoUrl="/logo.png" failed={false} onRetry={vi.fn()} />);
+  expect(screen.getByRole('status')).toHaveTextContent('Checking login…');
+  expect(screen.queryByRole('button')).toBeNull();
+  expect(screen.getByRole('img')).toHaveAttribute('src', '/logo.png');
+});
+it('offers one retry only when checking failed', () => {
+  const retry = vi.fn();
+  render(<AutoSsoScreen appName="femboyz mail" logoUrl="/logo.png" failed onRetry={retry} />);
