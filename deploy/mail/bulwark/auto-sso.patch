+import React from 'react';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { recordAutoSsoFailure } from '@/lib/auth/auto-sso';
+import LoginPage from '../page';
+
+const fixture = vi.hoisted(() => ({
+  api: vi.fn(),
+  router: { push: vi.fn(), prefetch: vi.fn() },
+  auth: { isAuthenticated: false, isLoading: false, error: null, clearError: vi.fn() },
+  theme: { theme: 'dark', resolvedTheme: 'dark', setTheme: vi.fn(), initializeTheme: vi.fn() },
+  config: {
+    appName: 'femboyz mail', jmapServerUrl: 'https://mx.example.test', oauthEnabled: true,
+    oauthOnly: true, autoSsoEnabled: true, oauthClientId: 'bulwark',
+    oauthIssuerUrl: 'https://id.example.test', oauthScopes: 'openid email',
+    isLoading: false, error: null, jmapServers: [], loginLogoLightUrl: '/logo.png',
+    loginLogoDarkUrl: '/logo.png',
+  },
+}));
+vi.mock('next/navigation', () => ({
+  useParams: () => ({ locale: 'en' }), useSearchParams: () => new URLSearchParams(),
+}));
+vi.mock('@/hooks/use-config', () => ({ useConfig: () => fixture.config }));
+vi.mock('@/i18n/navigation', () => ({ useRouter: () => fixture.router }));
+vi.mock('@/stores/auth-store', () => ({ useAuthStore: () => fixture.auth, consumeSignedOut: () => false }));
+vi.mock('@/stores/theme-store', () => ({ useThemeStore: Object.assign(
+  (select: (value: typeof fixture.theme) => unknown) => select(fixture.theme),
+  { subscribe: () => () => {}, getState: () => fixture.theme },
+) }));
+vi.mock('@/lib/browser-navigation', () => ({
+  apiFetch: (...args: unknown[]) => fixture.api(...args), getPathPrefix: () => '',
+  toRouterPath: (path: string) => path, withBasePath: (path: string) => path,
+}));
+
+const ok = { ok: true, json: async () => ({ authorization_endpoint: 'https://id.example.test/auth', token_endpoint: 'https://id.example.test/token' }) };
+const starting = () => fixture.api.mock.calls.filter(([url]) => url === '/api/auth/sso/start').length;
+beforeEach(() => {
+  sessionStorage.clear(); vi.clearAllMocks();
+  fixture.api.mockReset(); fixture.config.isLoading = false;
+  fixture.api.mockImplementation((url: string) => url.startsWith('/api/auth/oauth/metadata') ? Promise.resolve(ok) : new Promise(() => {}));
+});
+afterEach(cleanup);
+
+it('shows checking without a button while automatic sign-in is starting', async () => {
+  render(<LoginPage />);
+  expect(screen.getByRole('status')).toHaveTextContent('Checking login…');
+  await waitFor(() => expect(starting()).toBe(1));
+  expect(screen.queryByRole('button')).toBeNull();
+});
+
+it('starts again immediately after abandoning the provider form and reopening Mail', async () => {
+  const first = render(<LoginPage />);
+  await waitFor(() => expect(starting()).toBe(1));
+  first.unmount(); // The browser left for the provider and returned through Home → Mail.
+  render(<LoginPage />);
+  await waitFor(() => expect(starting()).toBe(2));
+  expect(screen.getByRole('status')).toHaveTextContent('Checking login…');
+  expect(screen.queryByRole('button')).toBeNull();
+});
+
+it('shows a retry on discovery failure instead of spinning forever', async () => {
+  fixture.api.mockResolvedValue({ ok: false });
+  render(<LoginPage />);
+  expect(await screen.findByRole('button', { name: 'Try again' })).toBeVisible();
+  expect(starting()).toBe(0);
+});
+
+it('shows a retry when the start request times out, then resumes checking', async () => {
+  fixture.api.mockImplementation((url: string) => url.startsWith('/api/auth/oauth/metadata')
+    ? Promise.resolve(ok) : Promise.reject(new DOMException('timeout', 'TimeoutError')));
+  render(<LoginPage />);
+  const retry = await screen.findByRole('button', { name: 'Try again' });
+  fixture.api.mockImplementation((url: string) => url.startsWith('/api/auth/oauth/metadata') ? Promise.resolve(ok) : new Promise(() => {}));
+  fireEvent.click(retry);
+  await waitFor(() => expect(starting()).toBe(2));
+  expect(screen.getByRole('status')).toHaveTextContent('Checking login…');
+  expect(screen.queryByRole('button')).toBeNull();
+});
+
+it('keeps failed-callback protection but allows explicit retry to resume checking', async () => {
+  recordAutoSsoFailure();
+  render(<LoginPage />);
+  const retry = await screen.findByRole('button', { name: 'Try again' });
+  expect(starting()).toBe(0);
+  fireEvent.click(retry);
+  await waitFor(() => expect(starting()).toBe(1));
+  expect(screen.queryByRole('button')).toBeNull();
+});
