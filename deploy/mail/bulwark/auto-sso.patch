+import React from "react";
+import { act, cleanup, render } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { isPWAInstallPromptVisible, PWAInstallPrompt } from "../pwa-install-prompt";
+
+afterEach(cleanup);
+it("suppresses install prompts without rendering a toast or invoking browser UI", () => {
+  const { container, unmount } = render(<PWAInstallPrompt />);
+  const prompt = vi.fn();
+  const event = new Event("beforeinstallprompt", { cancelable: true });
+  Object.assign(event, { prompt });
+  act(() => { window.dispatchEvent(event); });
+  expect(event.defaultPrevented).toBe(true);
+  expect(prompt).not.toHaveBeenCalled();
+  expect(container).toBeEmptyDOMElement();
+  expect(isPWAInstallPromptVisible()).toBe(false);
+  unmount();
+  const afterUnmount = new Event("beforeinstallprompt", { cancelable: true });
+  window.dispatchEvent(afterUnmount);
+  expect(afterUnmount.defaultPrevented).toBe(false);
+});
+it("also suppresses install UI for browsers with an old dismissal flag", () => {
+  localStorage.setItem("pwa-install-dismissed", "1");
+  const { container } = render(<PWAInstallPrompt />);
+  const event = new Event("beforeinstallprompt", { cancelable: true });
+  act(() => { window.dispatchEvent(event); });
+  expect(event.defaultPrevented).toBe(true);
+  expect(container).toBeEmptyDOMElement();
+  localStorage.clear();
 });
