# Installed at /etc/femboyz-mail/webmail/bulwark.env (root:root, 600).
JMAP_SERVER_URL=https://mx.femboyz.cloud
OAUTH_ENABLED=true
OAUTH_ONLY=true
AUTO_SSO_ENABLED=true
OAUTH_ISSUER_URL=https://femboyz.cloud/oidc
OAUTH_CLIENT_ID=bulwark
OAUTH_CLIENT_SECRET_FILE=/run/secrets/bulwark_oauth
OAUTH_SCOPES=openid email profile offline_access
OAUTH_END_SESSION=true
OAUTH_POST_LOGOUT_REDIRECT_URI=https://femboyz.cloud/
SESSION_SECRET_FILE=/run/secrets/bulwark_session
APP_NAME=femboyz mail
APP_SHORT_NAME=femboyz
APP_DESCRIPTION=Your femboyz.cloud mailbox
FAVICON_URL=/branding/femboyz/favicon.webp
PWA_ICON_URL=/branding/femboyz/favicon.webp
LOGIN_LOGO_LIGHT_URL=/branding/femboyz/logo.webp
LOGIN_LOGO_DARK_URL=/branding/femboyz/logo.webp
APP_LOGO_DARK_URL=/branding/femboyz/logo.webp
APP_LOGO_LIGHT_URL=/branding/femboyz/logo.webp
PWA_THEME_COLOR="#060606"
PWA_BACKGROUND_COLOR="#060606"
ADMIN_CONFIG_DIR=/app/data/admin
ADMIN_STATE_DIR=/app/data/admin-state
ADMIN_CONFIG_READONLY=true
STALWART_ADMIN_ACCESS=off
SETTINGS_SYNC_ENABLED=true
SETTINGS_DATA_DIR=/app/data/settings
BULWARK_TELEMETRY=off
LOG_FORMAT=json
LOG_LEVEL=info
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
