# /etc/femboyz-mail/backup.env (root:root, 600)
# Set the secret key with `sudo femboyz-mail-backup set-secret`, not by hand.
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/femboyz-cloud-bucket/femboyz-mail
RESTIC_PASSWORD_FILE=/etc/femboyz-mail/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
